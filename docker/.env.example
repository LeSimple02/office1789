# Template .env pour docker en production

# PostgreSQL Main Database
POSTGRES_USER=office1789_user
POSTGRES_PASSWORD=CHANGE_ME_MAIN_DB_PASSWORD
POSTGRES_DB=office1789

# Roundcube Database
ROUNDCUBE_DB_USER=roundcube_user
ROUNDCUBE_DB_PASSWORD=CHANGE_ME_ROUNDCUBE_DB_PASSWORD
ROUNDCUBE_DB_NAME=roundcube

# Synapse Database
SYNAPSE_DB_USER=synapse_user
SYNAPSE_DB_PASSWORD=CHANGE_ME_SYNapse_DB_PASSWORD
SYNAPSE_DB_NAME=synapse

# Coturn (TURN server)
COTURN_SECRET=CHANGE_ME_COTURN_SECRET

# OnlyOffice
ONLYOFFICE_JWT_SECRET=CHANGE_ME_ONLYOFFICE_JWT_SECRET

# Matrix
MATRIX_ADMIN_TOKEN=CHANGE_ME_MATRIX_ADMIN_TOKEN

# Mail Server
MAIL_ADMIN_USER=admin
MAIL_ADMIN_PASSWORD=CHANGE_ME_MAIL_ADMIN_PASSWORD
