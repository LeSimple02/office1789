<?xml version='1.0' encoding='utf-8'?>
<widget id="com.office1789.app" version="0.0.1" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Office1789</name>
    <description>Office1789 mobile wrapper (Cordova)</description>
    <author email="dev@office1789.local" href="https://office1789.example">Office1789 Team</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-navigation href="*" />
    <icon src="resources/android/icon/ic_launcher.png" />
    <preference name="loglevel" value="DEBUG" />
    <preference name="SplashScreen" value="screen" />
    <preference name="ShowSplashScreen" value="true" />
    <preference name="Fullscreen" value="true" />
    <preference name="Orientation" value="portrait" />
    <preference name="AndroidInsecureFileModeEnabled" value="false" />
    <preference name="AllowInlineMediaPlayback" value="true" />
    <preference name="AndroidXEnabled" value="true" />
    <preference name="ShowSplashScreenSpinner" value="false" />
    <preference name="SplashScreenDelay" value="500" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="FadeSplashScreen" value="true" />
    <preference name="FadeSplashScreenDuration" value="150" />
    <preference name="SplashScreenBackgroundColor" value="#FFFFFF" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/android/splash/screen-xxxhdpi-portrait.png" />
    <preference name="AndroidWindowSplashScreenBackground" value="#FFFFFF" />
</widget>
