# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=office1789

# Frontend URL
FRONTEND_URL=http://localhost:5173

# OVH SMS Configuration (pour l'envoi de SMS de vérification)
# Obtenir ces valeurs sur https://api.ovh.com/createToken/
# Guide: https://docs.ovh.com/fr/sms/envoyer-des-sms-depuis-une-url-http/
# Si non configuré, les codes SMS seront loggés dans la console (mode dev)
OVH_SMS_APPLICATION_KEY=your_application_key
OVH_SMS_APPLICATION_SECRET=your_application_secret
OVH_SMS_CONSUMER_KEY=your_consumer_key
OVH_SMS_SERVICE_NAME=sms-xxXXXX-1  # Nom de votre service SMS OVH
OVH_SMS_SENDER=Office1789  # Nom de l'expéditeur (max 11 caractères alphanumériques)

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (créés dans le dashboard Stripe)
STRIPE_PRICE_STANDARD=price_standard_monthly      # 5€/mois
STRIPE_PRICE_PROFESSIONAL=price_professional_monthly  # 12€/mois
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly      # 49€/mois

# AES Encryption Key (32 bytes for AES-256)
AES_KEY=your_32_byte_encryption_key_here

# Matrix Configuration
MATRIX_HOMESERVER=https://matrix.office1789.com
MATRIX_ADMIN_TOKEN=your_matrix_admin_token

# Mail Configuration
MAIL_SERVER=mail.office1789.com
MAIL_ADMIN_USER=admin
MAIL_ADMIN_PASSWORD=your_mail_admin_password
